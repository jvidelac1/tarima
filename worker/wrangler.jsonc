// Worker «tarima» (docs/MVP.md 5.5): responde /api/*, /qx/* (proxy de PostHog), /baja y /confirmar.
// NO tiene dirección pública: ni workers.dev, ni direcciones de vista previa, ni rutas. Le llegan los pedidos solo por la
// service binding del proyecto de Pages «liftinggame» (../wrangler.jsonc y ../functions/), que sirve web/ y le pasa esas
// rutas. Los secretos NO van acá: los carga tools/desplegar.sh con `wrangler secret put` (ver worker/README.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tarima",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],

  // Sin dirección pública: la dirección workers.dev de la cuenta no tiene que aparecer en ningún lado.
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tarima",
      "database_id": "9e2c28f3-67de-4cc6-a278-2d0e5f34e055",
      "migrations_dir": "migraciones"
    }
  ],

  // Primera barrera contra ráfagas, por código de IP. Las ventanas largas (10 min, 1 h) se cuentan en D1:
  // este límite solo admite períodos de 10 o 60 segundos.
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "4101", "simple": { "limit": 40, "period": 10 } }
  ],

  // Limpieza diaria: códigos de IP a los 30 días, partidas y dispositivos a los 180, y las altas que recibieron el
  // correo de confirmación y no confirmaron en 30 días (sin envío de correos no se borra ninguna alta).
  "triggers": { "crons": ["17 4 * * *"] },

  // Email Sending: para activarlo, sacar el comentario y poner MAIL_DESDE con una casilla del dominio verificado.
  // "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "POSTHOG_HOST": "us.i.posthog.com",
    "POSTHOG_ASSETS": "us-assets.i.posthog.com",
    "GRATIS": "2",
    "TOPE_IP": "6",
    "BONO_ENCUESTA": "2",
    "ENCUESTAS_POR_IP": "3",
    "ENCUESTA_ID": "",
    "ENCUESTA_PREGUNTAS": "",
    "MAIL_DESDE": "",
    "TURNSTILE": "0",
    // La IP y el país del visitante llegan en x-tarima-ip y x-tarima-pais, que pone la Function de Pages (pisando lo
    // que mande el navegador). Solo es seguro porque este Worker no tiene dirección pública: si algún día se le agrega
    // una ruta o workers.dev, esto va en "0".
    "CONFIAR_PAGES": "1"
  },

  // Registros propios en JSON y sin datos personales. Los registros automáticos de cada pedido y las trazas quedan
  // apagados porque guardan la URL completa (los links de /baja y /confirmar llevan el token) y datos de la conexión.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
